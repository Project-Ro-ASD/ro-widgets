#!/usr/bin/env bash
# ro-widgets CI (Fedora 44 konteyneri): widget sözleşmesi, QML sözdizimi, RPM derleme.
set -euo pipefail
cd "$(dirname "$0")/.."

if command -v dnf >/dev/null 2>&1 && [[ "$(id -u)" -eq 0 ]]; then
  # rpm-build burada kurulmaz: tools/build-rpm kendisi kurar (yayın iş akışıyla aynı yol).
  dnf -y -q install python3 qt6-qtdeclarative-devel >/dev/null
fi

python3 tools/check-widgets.py

# Token kopyası Ro-Theme main ile aynı mı: ağ ya da Ro-Theme'deki bir değişiklik bu repodaki PR'ı durdurmasın diye uyarı.
tools/sync-tokens --check main || echo "::warning::RoTokens.qml Ro-Theme main ile aynı değil (ya da indirilemedi); tools/sync-tokens çalıştırın"

QMLFORMAT="$(command -v qmlformat-qt6 || command -v qmlformat || echo /usr/lib64/qt6/bin/qmlformat)"
if [[ -x "$QMLFORMAT" ]]; then
  fail=0
  while IFS= read -r f; do
    "$QMLFORMAT" "$f" >/dev/null 2>"/tmp/qmlformat.err" || { echo "[FAIL] QML sözdizimi: $f"; cat /tmp/qmlformat.err; fail=1; }
  done < <(find . -path ./.git -prune -o -name '*.qml' -print | sort)
  [[ "$fail" -eq 0 ]] && echo "QML sözdizimi: tamam"
  [[ "$fail" -eq 0 ]]
else
  echo "qmlformat bulunamadı; QML sözdizimi denetimi atlandı" >&2
  [[ -z "${CI:-}" ]] || exit 1
fi

out="$(mktemp -d)"
tools/build-rpm 0.0.0 noarch "$out"
ls "$out"
