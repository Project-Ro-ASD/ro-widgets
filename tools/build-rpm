#!/usr/bin/env bash
# Fedora 44 RPM ve SRPM üretir: tools/build-rpm <sürüm> <mimari> <çıktı-klasörü>.
# Widget'lar mimariden bağımsızdır (noarch); mimari argümanı şablon sözleşmesi için alınır.
set -euo pipefail

VERSION="${1:-}"
ARCH="${2:-}"
OUTDIR="${3:-}"
if [[ -z "${VERSION}" || -z "${ARCH}" || -z "${OUTDIR}" ]]; then
  echo "usage: tools/build-rpm <version> <arch> <output-dir>" >&2
  exit 2
fi
VERSION="${VERSION#v}"

cd "$(dirname "$0")/.."
top="$(mktemp -d)"
mkdir -p "$top"/{SOURCES,SPECS,BUILD,RPMS,SRPMS} "$OUTDIR"
tar --exclude=.git --exclude=.github --transform "s,^\.,ro-widgets-${VERSION}," -czf "$top/SOURCES/ro-widgets-${VERSION}.tar.gz" .
cp packaging/ro-widgets.spec "$top/SPECS/"
rpmbuild --define "_topdir $top" --define "ro_version ${VERSION}" --define "dist .fc44" -ba "$top/SPECS/ro-widgets.spec" >/dev/null
find "$top/RPMS" "$top/SRPMS" -name '*.rpm' -exec cp {} "$OUTDIR/" \;
