# Dolphin ve masaüstünde her dosya ve klasörün sağ tık menüsü (uygulama kısayolları dahil). Name[<dil>] satırları paket
# derlenirken po/ dosyalarından eklenir (tools/desktop-i18n.py).
[Desktop Entry]
Type=Service
MimeType=all/all;
Actions=addToRoLauncherCategory;
X-KDE-ShowIfRunning=org.kde.plasmashell

[Desktop Action addToRoLauncherCategory]
Name=Add to Ro Launcher Category…
Icon=ro-start
Exec=/usr/libexec/ro-widgets/ro-launcher-add-to-category %F
