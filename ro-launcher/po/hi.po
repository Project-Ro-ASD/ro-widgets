#: contents/ui/ConfigGeneral.qml
msgid "Use classic categories and places navigation"
msgstr "क्लासिक श्रेणियों और स्थानों के नेविगेशन का उपयोग करें"

#: contents/ui/ConfigGeneral.qml
msgid "Show custom categories"
msgstr "कस्टम श्रेणियाँ दिखाएँ"

#: contents/ui/CategoryStore.qml
msgid "Add to Category"
msgstr "श्रेणी में जोड़ें"

#: contents/ui/CategoryStore.qml
msgid "New Category…"
msgstr "नई श्रेणी…"

#: contents/ui/CategoryDialog.qml
msgid "New Category"
msgstr "नई श्रेणी"

#: contents/ui/CategoryStore.qml
msgid "Remove from Category"
msgstr "श्रेणी से हटाएँ"

#: contents/ui/CategoryStore.qml
msgid "Rename…"
msgstr "नाम बदलें…"

#: contents/ui/CategoryDialog.qml
msgid "Rename Category"
msgstr "श्रेणी का नाम बदलें"

#: contents/ui/CategoryStore.qml
msgid "Move Up"
msgstr "ऊपर ले जाएँ"

#: contents/ui/CategoryStore.qml
msgid "Move Down"
msgstr "नीचे ले जाएँ"

#: contents/ui/CategoryStore.qml
msgid "Delete Category"
msgstr "श्रेणी मिटाएँ"

#: contents/ui/CategoryDialog.qml
msgid "Category name"
msgstr "श्रेणी का नाम"

#: contents/ui/CategoryDialog.qml
msgid "Cancel"
msgstr "रद्द करें"

#: contents/ui/CategoryDialog.qml
msgid "OK"
msgstr "ठीक है"

#: contents/ui/CategoryDialog.qml
#, kde-format
msgid "Delete “%1”? The applications themselves are not removed."
msgstr "\"%1\" मिटाएँ? ऐप्लिकेशन स्वयं नहीं हटाए जाते।"

#: contents/ui/NormalPage.qml contents/ui/PlacesPage.qml
msgid "Right-click an application and choose “Add to Category”."
msgstr "किसी ऐप्लिकेशन पर दायाँ-क्लिक करें और \"श्रेणी में जोड़ें\" चुनें।"

#: contents/ui/NormalPage.qml
#, kde-format
msgid "Show all (%1)"
msgstr "सभी दिखाएँ (%1)"

#: contents/ui/NormalPage.qml
msgid "Show less"
msgstr "कम दिखाएँ"

#: servicemenu/ro-launcher-add-to-category.desktop
msgid "Add to Ro Launcher Favorites"
msgstr "Ro Launcher की पसंदीदा सूची में जोड़ें"

#: servicemenu/ro-launcher-add-to-category.desktop
msgid "Add to Ro Launcher Category…"
msgstr "Ro Launcher की श्रेणी में जोड़ें…"

#: servicemenu/ro-launcher-add-to-category
msgid "Ro Launcher was not found in the panel."
msgstr "पैनल में Ro Launcher नहीं मिला।"
