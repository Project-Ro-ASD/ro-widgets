#: contents/ui/ConfigGeneral.qml
msgid "Use classic categories and places navigation"
msgstr "Klassik kateqoriya və məkan naviqasiyasından istifadə etmək"

#: contents/ui/ConfigGeneral.qml
msgid "Show custom categories"
msgstr "Fərdi kateqoriyaları göstərmək"

#: contents/ui/CategoryStore.qml
msgid "Add to Category"
msgstr "Kateqoriyaya əlavə et"

#: contents/ui/CategoryStore.qml
msgid "New Category…"
msgstr "Yeni kateqoriya…"

#: contents/ui/CategoryDialog.qml
msgid "New Category"
msgstr "Yeni kateqoriya"

#: contents/ui/CategoryStore.qml
msgid "Remove from Category"
msgstr "Kateqoriyadan sil"

#: contents/ui/CategoryStore.qml
msgid "Rename…"
msgstr "Adını dəyiş…"

#: contents/ui/CategoryDialog.qml
msgid "Rename Category"
msgstr "Kateqoriyanın adını dəyiş"

#: contents/ui/CategoryStore.qml
msgid "Move Up"
msgstr "Yuxarı köçür"

#: contents/ui/CategoryStore.qml
msgid "Move Down"
msgstr "Aşağı köçür"

#: contents/ui/CategoryStore.qml
msgid "Delete Category"
msgstr "Kateqoriyanı sil"

#: contents/ui/CategoryDialog.qml
msgid "Category name"
msgstr "Kateqoriya adı"

#: contents/ui/CategoryDialog.qml
msgid "Cancel"
msgstr "İmtina"

#: contents/ui/CategoryDialog.qml
msgid "OK"
msgstr "Oldu"

#: contents/ui/CategoryDialog.qml
#, kde-format
msgid "Delete “%1”? The applications themselves are not removed."
msgstr "\"%1\" silinsin? Tətbiqlərin özləri silinmir."

#: contents/ui/NormalPage.qml contents/ui/PlacesPage.qml
msgid "Right-click an application and choose “Add to Category”."
msgstr "Tətbiqin üzərində sağ klikləyin və \"Kateqoriyaya əlavə et\" seçin."

#: contents/ui/NormalPage.qml
#, kde-format
msgid "Show all (%1)"
msgstr "Hamısını göstər (%1)"

#: contents/ui/NormalPage.qml
msgid "Show less"
msgstr "Daha az göstər"

#: servicemenu/ro-launcher-add-to-category.desktop
msgid "Add to Ro Launcher Category…"
msgstr "Ro Launcher kateqoriyasına əlavə et…"

#: servicemenu/ro-launcher-add-to-category
msgid "Ro Launcher was not found in the panel."
msgstr "Ro Launcher paneldə tapılmadı."

#: servicemenu/ro-launcher-add-to-category
msgid "The selected files are not installed applications."
msgstr "Seçilmiş fayllar quraşdırılmış tətbiqlər deyil."
