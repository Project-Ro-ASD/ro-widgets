#: contents/ui/ConfigGeneral.qml
msgid "Use classic categories and places navigation"
msgstr "Класическа навигация по категории и места"

#: contents/ui/ConfigGeneral.qml
msgid "Show custom categories"
msgstr "Показване на потребителски категории"

#: contents/ui/CategoryStore.qml
msgid "Add to Category"
msgstr "Добавяне към категория"

#: contents/ui/CategoryStore.qml
msgid "New Category…"
msgstr "Нова категория…"

#: contents/ui/CategoryDialog.qml
msgid "New Category"
msgstr "Нова категория"

#: contents/ui/CategoryStore.qml
msgid "Remove from Category"
msgstr "Премахване от категорията"

#: contents/ui/CategoryStore.qml
msgid "Rename…"
msgstr "Преименуване…"

#: contents/ui/CategoryDialog.qml
msgid "Rename Category"
msgstr "Преименуване на категорията"

#: contents/ui/CategoryStore.qml
msgid "Move Up"
msgstr "Преместване нагоре"

#: contents/ui/CategoryStore.qml
msgid "Move Down"
msgstr "Преместване надолу"

#: contents/ui/CategoryStore.qml
msgid "Delete Category"
msgstr "Изтриване на категорията"

#: contents/ui/CategoryDialog.qml
msgid "Category name"
msgstr "Име на категорията"

#: contents/ui/CategoryDialog.qml
msgid "Cancel"
msgstr "Отказ"

#: contents/ui/CategoryDialog.qml
msgid "OK"
msgstr "Добре"

#: contents/ui/CategoryDialog.qml
#, kde-format
msgid "Delete “%1”? The applications themselves are not removed."
msgstr "Изтриване на „%1“? Самите приложения не се премахват."

#: contents/ui/NormalPage.qml contents/ui/PlacesPage.qml
msgid "Right-click an application and choose “Add to Category”."
msgstr "Щракнете с десния бутон върху приложение и изберете „Добавяне към категория“."

#: contents/ui/NormalPage.qml
#, kde-format
msgid "Show all (%1)"
msgstr "Показване на всички (%1)"

#: contents/ui/NormalPage.qml
msgid "Show less"
msgstr "Показване на по-малко"

#: servicemenu/ro-launcher-add-to-category.desktop
msgid "Add to Ro Launcher Category…"
msgstr "Добавяне към категория в Ro Launcher…"

#: servicemenu/ro-launcher-add-to-category
msgid "Ro Launcher was not found in the panel."
msgstr "Ro Launcher не е намерен в панела."
