#: contents/ui/ConfigGeneral.qml
msgid "Use classic categories and places navigation"
msgstr "استخدم التنقل التقليدي بين الفئات والأماكن"

#: contents/ui/ConfigGeneral.qml
msgid "Show custom categories"
msgstr "إظهار الفئات المخصصة"

#: contents/ui/CategoryStore.qml
msgid "Add to Category"
msgstr "أضف إلى فئة"

#: contents/ui/CategoryStore.qml
msgid "New Category…"
msgstr "فئة جديدة…"

#: contents/ui/CategoryDialog.qml
msgid "New Category"
msgstr "فئة جديدة"

#: contents/ui/CategoryStore.qml
msgid "Remove from Category"
msgstr "أزل من الفئة"

#: contents/ui/CategoryStore.qml
msgid "Rename…"
msgstr "أعد التسمية…"

#: contents/ui/CategoryDialog.qml
msgid "Rename Category"
msgstr "أعد تسمية الفئة"

#: contents/ui/CategoryStore.qml
msgid "Move Up"
msgstr "انقل لأعلى"

#: contents/ui/CategoryStore.qml
msgid "Move Down"
msgstr "انقل لأسفل"

#: contents/ui/CategoryStore.qml
msgid "Delete Category"
msgstr "احذف الفئة"

#: contents/ui/CategoryDialog.qml
msgid "Category name"
msgstr "اسم الفئة"

#: contents/ui/CategoryDialog.qml
msgid "Cancel"
msgstr "ألغِ"

#: contents/ui/CategoryDialog.qml
msgid "OK"
msgstr "حسنًا"

#: contents/ui/CategoryDialog.qml
#, kde-format
msgid "Delete “%1”? The applications themselves are not removed."
msgstr "أتريد حذف ”%1“؟ لن تُزال التطبيقات نفسها."

#: contents/ui/NormalPage.qml contents/ui/PlacesPage.qml
msgid "Right-click an application and choose “Add to Category”."
msgstr "انقر بزر الفأرة الأيمن على تطبيق واختر ”أضف إلى فئة“."

#: contents/ui/NormalPage.qml
#, kde-format
msgid "Show all (%1)"
msgstr "أظهر الكل (%1)"

#: contents/ui/NormalPage.qml
msgid "Show less"
msgstr "أظهر أقل"

#: servicemenu/ro-launcher-add-to-category.desktop
msgid "Add to Ro Launcher Category…"
msgstr "أضف إلى فئة في Ro Launcher…"

#: servicemenu/ro-launcher-add-to-category
msgid "Ro Launcher was not found in the panel."
msgstr "لم يُعثر على Ro Launcher في اللوحة."
