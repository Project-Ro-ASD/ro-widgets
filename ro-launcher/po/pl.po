#: contents/ui/ConfigGeneral.qml
msgid "Show custom categories"
msgstr "Pokazuj własne kategorie"

#: contents/ui/CategoryStore.qml
msgid "Add to Category"
msgstr "Dodaj do kategorii"

#: contents/ui/CategoryStore.qml
msgid "New Category…"
msgstr "Nowa kategoria…"

#: contents/ui/CategoryDialog.qml
msgid "New Category"
msgstr "Nowa kategoria"

#: contents/ui/CategoryStore.qml
msgid "Remove from Category"
msgstr "Usuń z kategorii"

#: contents/ui/CategoryStore.qml
msgid "Rename…"
msgstr "Zmień nazwę…"

