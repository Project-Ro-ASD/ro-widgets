#: contents/ui/NormalPage.qml contents/ui/PlacesPage.qml
msgid "Right-click an application and choose “Add to Category”."
msgstr "Kliknij prawym przyciskiem na aplikację i wybierz „Dodaj do kategorii”."

#: contents/ui/NormalPage.qml
#, kde-format
msgid "Show all (%1)"
msgstr "Pokaż wszystkie (%1)"

#: contents/ui/NormalPage.qml
msgid "Show less"
msgstr "Pokaż mniej"
