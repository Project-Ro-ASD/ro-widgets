#: contents/ui/ConfigGeneral.qml
msgid "Use classic categories and places navigation"
msgstr "Санаттар мен орындар бойынша классикалық шарлауды пайдалану"

#: contents/ui/ConfigGeneral.qml
msgid "Show custom categories"
msgstr "Пайдаланушы санаттарын көрсету"

#: contents/ui/CategoryStore.qml
msgid "Add to Category"
msgstr "Санатқа қосу"

#: contents/ui/CategoryStore.qml
msgid "New Category…"
msgstr "Жаңа санат…"

#: contents/ui/CategoryDialog.qml
msgid "New Category"
msgstr "Жаңа санат"

#: contents/ui/CategoryStore.qml
msgid "Remove from Category"
msgstr "Санаттан алып тастау"

#: contents/ui/CategoryStore.qml
msgid "Rename…"
msgstr "Атын өзгерту…"

#: contents/ui/CategoryDialog.qml
msgid "Rename Category"
msgstr "Санат атын өзгерту"

#: contents/ui/CategoryStore.qml
msgid "Move Up"
msgstr "Жоғары жылжыту"

#: contents/ui/CategoryStore.qml
msgid "Move Down"
msgstr "Төмен жылжыту"

#: contents/ui/CategoryStore.qml
msgid "Delete Category"
msgstr "Санатты жою"

#: contents/ui/CategoryDialog.qml
msgid "Category name"
msgstr "Санат атауы"

#: contents/ui/CategoryDialog.qml
msgid "Cancel"
msgstr "Бас тарту"

#: contents/ui/CategoryDialog.qml
msgid "OK"
msgstr "ОК"

#: contents/ui/CategoryDialog.qml
#, kde-format
msgid "Delete “%1”? The applications themselves are not removed."
msgstr "«%1» жойылсын ба? Қолданбалардың өздері жойылмайды."

#: contents/ui/NormalPage.qml contents/ui/PlacesPage.qml
msgid "Right-click an application and choose “Add to Category”."
msgstr "Қолданбаны тінтуірдің оң жақ батырмасымен басып, «Санатқа қосу» тармағын таңдаңыз."

#: contents/ui/NormalPage.qml
#, kde-format
msgid "Show all (%1)"
msgstr "Барлығын көрсету (%1)"

#: contents/ui/NormalPage.qml
msgid "Show less"
msgstr "Азырақ көрсету"

#: servicemenu/ro-launcher-add-to-category.desktop
msgid "Add to Ro Launcher Category…"
msgstr "Ro Launcher санатына қосу…"

#: servicemenu/ro-launcher-add-to-category
msgid "Ro Launcher was not found in the panel."
msgstr "Панельден Ro Launcher табылмады."
