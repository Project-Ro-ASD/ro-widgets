#: contents/ui/ConfigGeneral.qml
msgid "Use classic categories and places navigation"
msgstr "Истифодаи паймоиши классикӣ аз рӯи категорияҳо ва ҷойҳо"

#: contents/ui/ConfigGeneral.qml
msgid "Show custom categories"
msgstr "Намоиш додани категорияҳои фармоишӣ"

#: contents/ui/CategoryStore.qml
msgid "Add to Category"
msgstr "Илова ба категория"

#: contents/ui/CategoryStore.qml
msgid "New Category…"
msgstr "Категорияи нав…"

#: contents/ui/CategoryDialog.qml
msgid "New Category"
msgstr "Категорияи нав"

#: contents/ui/CategoryStore.qml
msgid "Remove from Category"
msgstr "Тоза кардан аз категория"

#: contents/ui/CategoryStore.qml
msgid "Rename…"
msgstr "Тағйири ном…"

#: contents/ui/CategoryDialog.qml
msgid "Rename Category"
msgstr "Тағйири номи категория"

#: contents/ui/CategoryStore.qml
msgid "Move Up"
msgstr "Ба боло гузоштан"

#: contents/ui/CategoryStore.qml
msgid "Move Down"
msgstr "Ба поён гузоштан"

#: contents/ui/CategoryStore.qml
msgid "Delete Category"
msgstr "Нест кардани категория"

#: contents/ui/CategoryDialog.qml
msgid "Category name"
msgstr "Номи категория"

#: contents/ui/CategoryDialog.qml
msgid "Cancel"
msgstr "Бекор кардан"

#: contents/ui/CategoryDialog.qml
msgid "OK"
msgstr "ХУБ"

#: contents/ui/CategoryDialog.qml
#, kde-format
msgid "Delete “%1”? The applications themselves are not removed."
msgstr "«%1» нест карда шавад? Худи барномаҳо тоза карда намешаванд."

#: contents/ui/NormalPage.qml contents/ui/PlacesPage.qml
msgid "Right-click an application and choose “Add to Category”."
msgstr "Ба барнома тугмаи ростро зер кунед ва «Илова ба категория»-ро интихоб намоед."

#: contents/ui/NormalPage.qml
#, kde-format
msgid "Show all (%1)"
msgstr "Ҳамаро намоиш додан (%1)"

#: contents/ui/NormalPage.qml
msgid "Show less"
msgstr "Камтар намоиш додан"
