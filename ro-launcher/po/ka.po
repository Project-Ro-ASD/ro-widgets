#: contents/ui/ConfigGeneral.qml
msgid "Use classic categories and places navigation"
msgstr "კატეგორიებისა და ადგილების კლასიკური ნავიგაციის გამოყენება"

#: contents/ui/ConfigGeneral.qml
msgid "Show custom categories"
msgstr "მორგებული კატეგორიების ჩვენება"

#: contents/ui/CategoryStore.qml
msgid "Add to Category"
msgstr "კატეგორიაში დამატება"

#: contents/ui/CategoryStore.qml
msgid "New Category…"
msgstr "ახალი კატეგორია…"

#: contents/ui/CategoryDialog.qml
msgid "New Category"
msgstr "ახალი კატეგორია"

#: contents/ui/CategoryStore.qml
msgid "Remove from Category"
msgstr "კატეგორიიდან წაშლა"

#: contents/ui/CategoryStore.qml
msgid "Rename…"
msgstr "სახელის გადარქმევა…"

#: contents/ui/CategoryDialog.qml
msgid "Rename Category"
msgstr "კატეგორიის სახელის გადარქმევა"

#: contents/ui/CategoryStore.qml
msgid "Move Up"
msgstr "მაღლა აწევა"

#: contents/ui/CategoryStore.qml
msgid "Move Down"
msgstr "დაბლა ჩამოწევა"

#: contents/ui/CategoryStore.qml
msgid "Delete Category"
msgstr "კატეგორიის წაშლა"

#: contents/ui/CategoryDialog.qml
msgid "Category name"
msgstr "კატეგორიის სახელი"

#: contents/ui/CategoryDialog.qml
msgid "Cancel"
msgstr "გაუქმება"

#: contents/ui/CategoryDialog.qml
msgid "OK"
msgstr "დიახ"

#: contents/ui/CategoryDialog.qml
#, kde-format
msgid "Delete “%1”? The applications themselves are not removed."
msgstr "წავშალო „%1“? თავად აპლიკაციები არ წაიშლება."

#: contents/ui/NormalPage.qml contents/ui/PlacesPage.qml
msgid "Right-click an application and choose “Add to Category”."
msgstr "დააწკაპუნეთ აპლიკაციაზე მარჯვენა ღილაკით და აირჩიეთ „კატეგორიაში დამატება“."

#: contents/ui/NormalPage.qml
#, kde-format
msgid "Show all (%1)"
msgstr "ყველას ჩვენება (%1)"

#: contents/ui/NormalPage.qml
msgid "Show less"
msgstr "ნაკლების ჩვენება"

#: servicemenu/ro-launcher-add-to-category.desktop
msgid "Add to Ro Launcher Category…"
msgstr "Ro Launcher-ის კატეგორიაში დამატება…"

#: servicemenu/ro-launcher-add-to-category
msgid "Ro Launcher was not found in the panel."
msgstr "Ro Launcher პანელზე ვერ მოიძებნა."
