#: contents/ui/ConfigGeneral.qml
msgid "Use classic categories and places navigation"
msgstr "Použiť klasickú navigáciu podľa kategórií a miest"

#: contents/ui/ConfigGeneral.qml
msgid "Show custom categories"
msgstr "Zobraziť vlastné kategórie"

#: contents/ui/CategoryStore.qml
msgid "Add to Category"
msgstr "Pridať do kategórie"

#: contents/ui/CategoryStore.qml
msgid "New Category…"
msgstr "Nová kategória…"

#: contents/ui/CategoryDialog.qml
msgid "New Category"
msgstr "Nová kategória"

#: contents/ui/CategoryStore.qml
msgid "Remove from Category"
msgstr "Odstrániť z kategórie"

#: contents/ui/CategoryStore.qml
msgid "Rename…"
msgstr "Premenovať…"

#: contents/ui/CategoryDialog.qml
msgid "Rename Category"
msgstr "Premenovať kategóriu"

#: contents/ui/CategoryStore.qml
msgid "Move Up"
msgstr "Posunúť nahor"

#: contents/ui/CategoryStore.qml
msgid "Move Down"
msgstr "Posunúť nadol"

#: contents/ui/CategoryStore.qml
msgid "Delete Category"
msgstr "Vymazať kategóriu"

#: contents/ui/CategoryDialog.qml
msgid "Category name"
msgstr "Názov kategórie"

#: contents/ui/CategoryDialog.qml
msgid "Cancel"
