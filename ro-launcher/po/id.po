#: contents/ui/ConfigGeneral.qml
msgid "Use classic categories and places navigation"
msgstr "Gunakan navigasi kategori dan tempat klasik"

#: contents/ui/ConfigGeneral.qml
msgid "Show custom categories"
msgstr "Tampilkan kategori khusus"

#: contents/ui/CategoryStore.qml
msgid "Add to Category"
msgstr "Tambahkan ke Kategori"

#: contents/ui/CategoryStore.qml
msgid "New Category…"
msgstr "Kategori Baru…"

#: contents/ui/CategoryDialog.qml
msgid "New Category"
msgstr "Kategori Baru"

#: contents/ui/CategoryStore.qml
msgid "Remove from Category"
msgstr "Hapus dari Kategori"

#: contents/ui/CategoryStore.qml
msgid "Rename…"
msgstr "Ganti Nama…"

#: contents/ui/CategoryDialog.qml
msgid "Rename Category"
msgstr "Ganti Nama Kategori"

#: contents/ui/CategoryStore.qml
msgid "Move Up"
msgstr "Pindah ke Atas"

#: contents/ui/CategoryStore.qml
msgid "Move Down"
msgstr "Pindah ke Bawah"

#: contents/ui/CategoryStore.qml
msgid "Delete Category"
msgstr "Hapus Kategori"

#: contents/ui/CategoryDialog.qml
msgid "Category name"
msgstr "Nama kategori"

#: contents/ui/CategoryDialog.qml
msgid "Cancel"
msgstr "Batal"

#: contents/ui/CategoryDialog.qml
msgid "OK"
msgstr "Oke"

#: contents/ui/CategoryDialog.qml
#, kde-format
msgid "Delete “%1”? The applications themselves are not removed."
msgstr "Hapus \"%1\"? Aplikasinya sendiri tidak dihapus."

#: contents/ui/NormalPage.qml contents/ui/PlacesPage.qml
msgid "Right-click an application and choose “Add to Category”."
msgstr "Klik kanan sebuah aplikasi lalu pilih \"Tambahkan ke Kategori\"."

#: contents/ui/NormalPage.qml
#, kde-format
msgid "Show all (%1)"
msgstr "Tampilkan semua (%1)"

#: contents/ui/NormalPage.qml
msgid "Show less"
msgstr "Tampilkan lebih sedikit"

#: servicemenu/ro-launcher-add-to-category.desktop
msgid "Add to Ro Launcher Category…"
msgstr "Tambahkan ke Kategori Ro Launcher…"

#: servicemenu/ro-launcher-add-to-category
msgid "Ro Launcher was not found in the panel."
msgstr "Ro Launcher tidak ditemukan di panel."

#: servicemenu/ro-launcher-add-to-category
msgid "The selected files are not installed applications."
msgstr "Berkas yang dipilih bukan aplikasi terpasang."
