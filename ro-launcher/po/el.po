#: contents/ui/ConfigGeneral.qml
msgid "Use classic categories and places navigation"
msgstr "Χρήση κλασικής πλοήγησης σε κατηγορίες και τοποθεσίες"

#: contents/ui/ConfigGeneral.qml
msgid "Show custom categories"
msgstr "Εμφάνιση προσαρμοσμένων κατηγοριών"

#: contents/ui/CategoryStore.qml
msgid "Add to Category"
msgstr "Προσθήκη σε κατηγορία"

#: contents/ui/CategoryStore.qml
msgid "New Category…"
msgstr "Νέα κατηγορία…"

#: contents/ui/CategoryDialog.qml
msgid "New Category"
msgstr "Νέα κατηγορία"

#: contents/ui/CategoryStore.qml
msgid "Remove from Category"
msgstr "Αφαίρεση από την κατηγορία"

#: contents/ui/CategoryStore.qml
msgid "Rename…"
msgstr "Μετονομασία…"

#: contents/ui/CategoryDialog.qml
msgid "Rename Category"
msgstr "Μετονομασία κατηγορίας"

#: contents/ui/CategoryStore.qml
msgid "Move Up"
msgstr "Μετακίνηση πάνω"

#: contents/ui/CategoryStore.qml
msgid "Move Down"
msgstr "Μετακίνηση κάτω"

#: contents/ui/CategoryStore.qml
msgid "Delete Category"
msgstr "Διαγραφή κατηγορίας"

#: contents/ui/CategoryDialog.qml
msgid "Category name"
msgstr "Όνομα κατηγορίας"

#: contents/ui/CategoryDialog.qml
msgid "Cancel"
msgstr "Ακύρωση"

#: contents/ui/CategoryDialog.qml
msgid "OK"
msgstr "Εντάξει"

#: contents/ui/CategoryDialog.qml
#, kde-format
msgid "Delete “%1”? The applications themselves are not removed."
msgstr "Διαγραφή του «%1»; Οι ίδιες οι εφαρμογές δεν αφαιρούνται."

#: contents/ui/NormalPage.qml contents/ui/PlacesPage.qml
msgid "Right-click an application and choose “Add to Category”."
msgstr "Κάντε δεξί κλικ σε μια εφαρμογή και επιλέξτε «Προσθήκη σε κατηγορία»."

#: contents/ui/NormalPage.qml
#, kde-format
msgid "Show all (%1)"
msgstr "Εμφάνιση όλων (%1)"

#: contents/ui/NormalPage.qml
msgid "Show less"
msgstr "Εμφάνιση λιγότερων"

#: servicemenu/ro-launcher-add-to-category.desktop
msgid "Add to Ro Launcher Category…"
msgstr "Προσθήκη σε κατηγορία του Ro Launcher…"

#: servicemenu/ro-launcher-add-to-category
msgid "Ro Launcher was not found in the panel."
msgstr "Το Ro Launcher δεν βρέθηκε στον πίνακα."

#: servicemenu/ro-launcher-add-to-category
msgid "The selected files are not installed applications."
msgstr "Τα επιλεγμένα αρχεία δεν είναι εγκατεστημένες εφαρμογές."
