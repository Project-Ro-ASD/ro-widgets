#: contents/ui/ConfigGeneral.qml
msgid "Use classic categories and places navigation"
msgstr "Izmantot klasisko navigāciju pa kategorijām un vietām"

#: contents/ui/ConfigGeneral.qml
msgid "Show custom categories"
msgstr "Rādīt pielāgotās kategorijas"

#: contents/ui/CategoryStore.qml
msgid "Add to Category"
msgstr "Pievienot kategorijai"

#: contents/ui/CategoryStore.qml
msgid "New Category…"
msgstr "Jauna kategorija…"

#: contents/ui/CategoryDialog.qml
msgid "New Category"
msgstr "Jauna kategorija"

#: contents/ui/CategoryStore.qml
msgid "Remove from Category"
msgstr "Izņemt no kategorijas"

#: contents/ui/CategoryStore.qml
msgid "Rename…"
msgstr "Pārdēvēt…"

#: contents/ui/CategoryDialog.qml
msgid "Rename Category"
msgstr "Pārdēvēt kategoriju"

#: contents/ui/CategoryStore.qml
msgid "Move Up"
msgstr "Pārvietot augšup"

#: contents/ui/CategoryStore.qml
msgid "Move Down"
msgstr "Pārvietot lejup"

#: contents/ui/CategoryStore.qml
msgid "Delete Category"
msgstr "Dzēst kategoriju"

#: contents/ui/CategoryDialog.qml
msgid "Category name"
msgstr "Kategorijas nosaukums"

#: contents/ui/CategoryDialog.qml
msgid "Cancel"
msgstr "Atcelt"

#: contents/ui/CategoryDialog.qml
msgid "OK"
msgstr "Labi"

#: contents/ui/CategoryDialog.qml
#, kde-format
msgid "Delete “%1”? The applications themselves are not removed."
msgstr "Dzēst „%1“? Pašas lietotnes netiek izņemtas."

#: contents/ui/NormalPage.qml contents/ui/PlacesPage.qml
msgid "Right-click an application and choose “Add to Category”."
msgstr "Ar peles labo pogu noklikšķiniet uz lietotnes un izvēlieties „Pievienot kategorijai“."

#: contents/ui/NormalPage.qml
#, kde-format
msgid "Show all (%1)"
msgstr "Rādīt visu (%1)"

#: contents/ui/NormalPage.qml
msgid "Show less"
msgstr "Rādīt mazāk"
