#: contents/ui/ConfigGeneral.qml
msgid "Show custom categories"
msgstr "Pokaži kategorije po meri"

#: contents/ui/CategoryStore.qml
msgid "Add to Category"
msgstr "Dodaj v kategorijo"

#: contents/ui/CategoryStore.qml
msgid "New Category…"
msgstr "Nova kategorija…"

#: contents/ui/CategoryDialog.qml
msgid "New Category"
msgstr "Nova kategorija"

#: contents/ui/CategoryStore.qml
msgid "Remove from Category"
msgstr "Odstrani iz kategorije"

#: contents/ui/CategoryStore.qml
msgid "Rename…"
msgstr "Preimenuj…"

#: contents/ui/CategoryDialog.qml
msgid "Rename Category"
msgstr "Preimenuj kategorijo"

#: contents/ui/CategoryStore.qml
msgid "Move Up"
msgstr "Premakni gor"

#: contents/ui/CategoryStore.qml
msgid "Move Down"
msgstr "Premakni dol"

#: contents/ui/CategoryStore.qml
msgid "Delete Category"
msgstr "Izbriši kategorijo"

