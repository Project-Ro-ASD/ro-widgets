#: contents/ui/ConfigGeneral.qml
msgid "Use classic categories and places navigation"
msgstr "शास्त्रीयवर्गाणां स्थानानां च नेविगेशनस्य उपयोगं कुर्वन्तु"

#: contents/ui/ConfigGeneral.qml
msgid "Show custom categories"
msgstr "स्वनिर्मितवर्गान् दर्शयतु"

#: contents/ui/CategoryStore.qml
msgid "Add to Category"
msgstr "वर्गे योजयतु"

#: contents/ui/CategoryStore.qml
msgid "New Category…"
msgstr "नूतनः वर्गः…"

#: contents/ui/CategoryDialog.qml
msgid "New Category"
msgstr "नूतनः वर्गः"

#: contents/ui/CategoryStore.qml
msgid "Remove from Category"
msgstr "वर्गात् अपसारयतु"

#: contents/ui/CategoryStore.qml
msgid "Rename…"
msgstr "पुनर्नामकरणम्…"

#: contents/ui/CategoryDialog.qml
msgid "Rename Category"
msgstr "वर्गस्य पुनर्नामकरणम्"

#: contents/ui/CategoryStore.qml
msgid "Move Up"
msgstr "उपरि नयतु"

#: contents/ui/CategoryStore.qml
msgid "Move Down"
msgstr "अधः नयतु"

#: contents/ui/CategoryStore.qml
msgid "Delete Category"
msgstr "वर्गं विलोपयतु"

#: contents/ui/CategoryDialog.qml
msgid "Category name"
msgstr "वर्गस्य नाम"

#: contents/ui/CategoryDialog.qml
msgid "Cancel"
msgstr "निरस्यतु"

#: contents/ui/CategoryDialog.qml
msgid "OK"
msgstr "अस्तु"

#: contents/ui/CategoryDialog.qml
#, kde-format
msgid "Delete “%1”? The applications themselves are not removed."
msgstr "\"%1\" विलोपयितव्यम् वा? अनुप्रयोगाः स्वयं न अपसार्यन्ते।"

#: contents/ui/NormalPage.qml contents/ui/PlacesPage.qml
msgid "Right-click an application and choose “Add to Category”."
msgstr "अनुप्रयोगे दक्षिणक्लिक् कृत्वा \"वर्गे योजयतु\" इति चिनोतु।"

#: contents/ui/NormalPage.qml
#, kde-format
msgid "Show all (%1)"
msgstr "सर्वं दर्शयतु (%1)"

#: contents/ui/NormalPage.qml
msgid "Show less"
msgstr "न्यूनं दर्शयतु"
