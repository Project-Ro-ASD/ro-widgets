#: contents/ui/ConfigGeneral.qml
msgid "Use classic categories and places navigation"
msgstr "Bruk klassisk navigering med kategoriar og stadar"

#: contents/ui/ConfigGeneral.qml
msgid "Show custom categories"
msgstr "Vis eigne kategoriar"

#: contents/ui/CategoryStore.qml
msgid "Add to Category"
msgstr "Legg til i kategori"

#: contents/ui/CategoryStore.qml
msgid "New Category…"
msgstr "Ny kategori …"

#: contents/ui/CategoryDialog.qml
msgid "New Category"
msgstr "Ny kategori"

#: contents/ui/CategoryStore.qml
msgid "Remove from Category"
msgstr "Fjern frå kategori"

#: contents/ui/CategoryStore.qml
msgid "Rename…"
msgstr "Endra namn …"

#: contents/ui/CategoryDialog.qml
msgid "Rename Category"
msgstr "Endra namn på kategori"

#: contents/ui/CategoryStore.qml
msgid "Move Up"
msgstr "Flytt opp"

#: contents/ui/CategoryStore.qml
msgid "Move Down"
msgstr "Flytt ned"

#: contents/ui/CategoryStore.qml
msgid "Delete Category"
msgstr "Slett kategori"

#: contents/ui/CategoryDialog.qml
msgid "Category name"
