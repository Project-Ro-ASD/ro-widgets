[Unit]
Description=Ro Launcher: show the "add to launcher" file menu entries only while the launcher is in use

[Service]
Type=oneshot
ExecStart=/usr/libexec/ro-widgets/ro-launcher-servicemenu sync

[Install]
WantedBy=default.target
